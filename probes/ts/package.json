{
  "name": "@davinci-chain/health-spec",
  "version": "1.0.0",
  "description": "DaVinci 服务健康标准的参考探针与契约校验器",
  "license": "MIT",
  "type": "module",
  "bin": {
    "health-spec": "dist/verify.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify": "node dist/verify.js verify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.mjs\"",
    "test:online": "npm run build && HEALTH_SPEC_ONLINE=1 node --test \"test/online.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
